  "_comment": "Editorial focus per category. Articles whose title/teaser match a topic are tagged and ranked first; after the article is opened, a match needs the topic in the title or 3+ mentions in the text. If any verified candidate matches, only matching articles can be picked for that category; otherwise a targeted web search runs, and only then does the category fall back to general picks. Patterns are case-insensitive Python regular expressions; (?-i:...) makes a part case-sensitive.",
  "3": {
   "label": "autism, ADHD, PTSD and bipolar disorder",
   "topics": {
    "Autism": [
     "\\bautis(m|tic|ts?)\\b",
     "\\b(?-i:ASD)\\b",
     "\\basperger",
     "\\bautism spectrum"
    ],
    "ADHD": [
     "\\b(?-i:ADHD)\\b",
     "\\battention[- ]deficit",
     "\\bhyperactivity disorder"
    ],
    "PTSD": [
     "\\b(?-i:C?-?PTSD)\\b",
     "\\bpost-?\\s?traumatic stress",
     "\\bcombat trauma\\b"
    ],
    "Bipolar disorder": [
     "\\bbipolar\\b",
     "\\bmanic[- ]depress",
     "\\bmanic episodes?\\b",
     "\\bmood stabili[sz]ers?\\b"
    ]
   }
  }
